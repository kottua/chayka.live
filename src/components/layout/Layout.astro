---
import '../../styles/global.css';
import Header from './Header.astro';
import Footer from './Footer.astro';
import CookieConsent from './CookieConsent.astro';
import SeoHead from '../seo/SeoHead.astro';
import { getSiteSettings } from '../../lib/data';
import { sanityImageUrl } from '../../lib/sanity/image';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  noindex?: boolean;
  image?: unknown;
}

const { title, description, canonicalPath, noindex = false, image } = Astro.props;
const siteSettings = await getSiteSettings();
const displaySiteName = siteSettings.professionalName || siteSettings.siteName;
const gtmId = import.meta.env.PUBLIC_GTM_ID;
const googleAdsId = import.meta.env.PUBLIC_GOOGLE_ADS_ID || 'AW-18348666135';
const directGoogleAdsId = gtmId ? undefined : googleAdsId;
const seoImage = image || siteSettings.defaultOgImage;
const imageUrl =
  typeof seoImage === 'string'
    ? new URL(seoImage, siteSettings.baseUrl).toString()
    : seoImage
      ? sanityImageUrl(seoImage)?.width(1200).height(630).fit('crop').auto('format').url()
      : null;
const faviconUrl = siteSettings.favicon
  ? sanityImageUrl(siteSettings.favicon)?.width(64).height(64).fit('crop').url()
  : null;
---

<!doctype html>
<html lang="uk">
  <head>
    <SeoHead
      title={title || siteSettings.defaultSeo?.title}
      description={description || siteSettings.defaultSeo?.description}
      canonicalPath={canonicalPath}
      noindex={noindex}
      siteName={displaySiteName}
      siteUrl={siteSettings.baseUrl}
      imageUrl={imageUrl}
      faviconUrl={faviconUrl}
    />
    {gtmId && (
      <script is:inline define:vars={{ gtmId }}>
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        const script = document.createElement('script');
        script.async = true;
        script.src = `https://www.googletagmanager.com/gtm.js?id=${gtmId}`;
        document.head.appendChild(script);
      </script>
    )}
    {directGoogleAdsId && (
      <script is:inline define:vars={{ directGoogleAdsId }}>
        window.dataLayer = window.dataLayer || [];
        window.gtag =
          window.gtag ||
          function () {
            window.dataLayer.push(arguments);
          };

        let consentChoice = null;
        try {
          consentChoice = window.localStorage.getItem('chayka-consent-v1');
        } catch {
          consentChoice = null;
        }

        const consentGranted = consentChoice === 'granted';
        window.gtag('consent', 'default', {
          ad_storage: consentGranted ? 'granted' : 'denied',
          ad_user_data: consentGranted ? 'granted' : 'denied',
          ad_personalization: 'denied',
          analytics_storage: consentGranted ? 'granted' : 'denied',
          wait_for_update: 500,
        });
        window.gtag('set', 'ads_data_redaction', true);
        window.gtag('js', new Date());
        window.gtag('config', directGoogleAdsId);

        const googleTag = document.createElement('script');
        googleTag.async = true;
        googleTag.src = `https://www.googletagmanager.com/gtag/js?id=${directGoogleAdsId}`;
        document.head.appendChild(googleTag);
      </script>
    )}
  </head>
  <body>
    {gtmId && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
        >
        </iframe>
      </noscript>
    )}
    <Header siteSettings={siteSettings} />
    <main>
      <slot />
    </main>
    <Footer siteSettings={siteSettings} />
    <CookieConsent enabled={Boolean(directGoogleAdsId)} />
    <script>
      document.addEventListener('click', (event) => {
        const target = event.target instanceof Element ? event.target.closest('[data-event]') : null;
        if (!(target instanceof HTMLElement)) return;

        const eventName = target.dataset.event || 'site_click';
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          event: eventName,
          channel: target.dataset.channel,
          placement: target.dataset.placement,
          page_type: target.dataset.pageType,
          content_id: target.dataset.contentId,
          cta_id: target.dataset.ctaId,
          tracking_context: target.dataset.trackingContext,
        });

        if (eventName !== 'cta_contact_click') return;

        const googleTagWindow = window as typeof window & {
          gtag?: (...args: unknown[]) => void;
        };
        if (typeof googleTagWindow.gtag !== 'function') return;

        const isRegularLinkClick =
          target instanceof HTMLAnchorElement &&
          event instanceof MouseEvent &&
          event.button === 0 &&
          !event.metaKey &&
          !event.ctrlKey &&
          !event.shiftKey &&
          !event.altKey;

        let navigationCompleted = false;
        const continueNavigation = () => {
          if (!isRegularLinkClick || navigationCompleted) return;
          navigationCompleted = true;
          window.location.href = target.href;
        };

        if (isRegularLinkClick) event.preventDefault();

        googleTagWindow.gtag('event', 'conversion', {
          send_to: 'AW-18348666135/gMpLCJ7SnNYcEJfaqa1E',
          value: 1.0,
          currency: 'UAH',
          event_callback: continueNavigation,
          event_timeout: 1000,
        });

        if (isRegularLinkClick) window.setTimeout(continueNavigation, 1000);
      });
    </script>
  </body>
</html>
