---
import SocialProfileLinks from '../cta/SocialProfileLinks.astro';
import { getContactSettings, getFooterNavItems, type SiteSettingsContent } from '../../lib/data';

interface Props {
  siteSettings: SiteSettingsContent;
}

const { siteSettings } = Astro.props;
const year = new Date().getFullYear();
const [contactSettings, footerNavItems] = await Promise.all([getContactSettings(), getFooterNavItems()]);
---

<footer class="border-t border-[var(--color-border)] bg-[var(--color-surface)]">
  <div class="container grid gap-8 py-10 md:grid-cols-[1fr_auto] md:items-end">
    <div>
      <p class="text-lg font-semibold">{siteSettings.siteName}</p>
      <p class="mt-2 max-w-xl text-sm leading-6 text-[var(--color-muted)]">
        {siteSettings.footerText}
      </p>
    </div>
    <div class="grid gap-5 md:justify-items-end">
      <SocialProfileLinks contactSettings={contactSettings} placement="footer" />
      {
        footerNavItems.length > 0 && (
          <nav class="flex flex-wrap gap-x-4 gap-y-2 text-sm text-[var(--color-muted)] md:justify-end" aria-label="Footer navigation">
            {footerNavItems.map((item) => (
              <a class="focus-ring hover:text-[var(--color-ink)]" href={item.href}>
                {item.label}
              </a>
            ))}
          </nav>
        )
      }
      <p class="text-sm text-[var(--color-muted)]">© {year}</p>
    </div>
  </div>
</footer>
