---
import SocialProfileLinks from '../cta/SocialProfileLinks.astro';
import { getContactSettings, getFooterNavItems, type SiteSettingsContent } from '../../lib/data';

interface Props {
  siteSettings: SiteSettingsContent;
}

const { siteSettings } = Astro.props;
const year = new Date().getFullYear();
const trackingEnabled = Boolean(
  import.meta.env.PUBLIC_GOOGLE_ADS_ID || import.meta.env.PUBLIC_GTM_ID || 'AW-18348666135',
);
const [contactSettings, footerNavItems] = await Promise.all([getContactSettings(), getFooterNavItems()]);
---

<footer class="border-t border-[var(--color-brand-primary-hover)] bg-[var(--color-brand-primary)] text-white">
  <div class="container grid gap-8 py-10 md:grid-cols-[1fr_auto] md:items-end">
    <div>
      <p class="text-lg font-semibold">{siteSettings.professionalName || siteSettings.siteName}</p>
      {siteSettings.professionalRole && <p class="text-sm text-white/75">{siteSettings.professionalRole}</p>}
      <p class="mt-3 max-w-xl text-sm leading-6 text-white/78">
        {siteSettings.footerText}
      </p>
    </div>
    <div class="grid gap-5 md:justify-items-end">
      <SocialProfileLinks contactSettings={contactSettings} placement="footer" />
      {
        footerNavItems.length > 0 && (
          <nav class="flex flex-wrap gap-x-4 gap-y-2 text-sm text-white/78 md:justify-end" aria-label="Footer navigation">
            {footerNavItems.map((item) => (
              <a class="focus-ring hover:text-white" href={item.href}>
                {item.label}
              </a>
            ))}
            {
              trackingEnabled && (
                <button class="focus-ring hover:text-white" type="button" data-cookie-settings>
                  Налаштування cookies
                </button>
              )
            }
          </nav>
        )
      }
      <p class="text-sm text-white/70">© {year}</p>
    </div>
  </div>
</footer>
