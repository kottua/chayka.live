---
import Layout from '../components/layout/Layout.astro';
import GlobalCTA from '../components/cta/GlobalCTA.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { getContactSettings, getDefaultCTA, getFaqItems, getPageContentSettings } from '../lib/data';
import { buildBreadcrumbJsonLd, buildFaqJsonLd } from '../lib/seo/jsonLd';

const [contactSettings, defaultCTA, faqItems, pageContent] = await Promise.all([
  getContactSettings(),
  getDefaultCTA(),
  getFaqItems(),
  getPageContentSettings(),
]);
---

<Layout
  title={pageContent.faqSeo?.title || 'Часті питання'}
  description={pageContent.faqSeo?.description || pageContent.faqDescription}
  canonicalPath="/faq"
  image={pageContent.faqSeo?.ogImage}
  noindex={pageContent.faqSeo?.noindex}
>
  <JsonLd data={buildBreadcrumbJsonLd([{ label: 'Часті питання', path: '/faq' }])} />
  <JsonLd data={buildFaqJsonLd(faqItems)} />
  <Breadcrumbs items={[{ label: 'Часті питання' }]} />
  <section class="section">
    <div class="container max-w-3xl">
      <p class="eyebrow">{pageContent.faqEyebrow}</p>
      <h1 class="mt-4 text-4xl font-semibold leading-tight md:text-5xl">{pageContent.faqTitle}</h1>
      <div class="mt-10 grid gap-4">
        {faqItems.map((item) => (
          <article class="rounded-lg border border-[var(--color-line)] bg-[var(--color-surface)] p-5">
            <h2 class="text-lg font-semibold">{item.question}</h2>
            <p class="mt-3 leading-7 text-[var(--color-muted)]">{item.answer}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <GlobalCTA placement="faq_final" pageType="faq" contactSettings={contactSettings} cta={defaultCTA} />
</Layout>
