---
import Layout from '../components/layout/Layout.astro';
import GlobalCTA from '../components/cta/GlobalCTA.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import PortableText from '../components/content/PortableText.astro';
import { getContactSettings, getDefaultCTA, getPageContentSettings, getSiteSettings } from '../lib/data';
import { sanityImageUrl } from '../lib/sanity/image';

const [contactSettings, defaultCTA, pageContent, siteSettings] = await Promise.all([
  getContactSettings(),
  getDefaultCTA(),
  getPageContentSettings(),
  getSiteSettings(),
]);
const aboutPhoto = pageContent.aboutPhoto || siteSettings.profilePhoto;
const profilePhotoUrl = aboutPhoto
  ? sanityImageUrl(aboutPhoto)?.width(1200).height(1500).fit('crop').auto('format').url()
  : null;
---

<Layout
  title={pageContent.aboutSeo?.title || 'Про психотерапевта'}
  description={pageContent.aboutSeo?.description || 'Підхід, освіта, професійний досвід, етичні межі й формат психотерапевтичної роботи онлайн.'}
  canonicalPath="/pro-mene"
  image={pageContent.aboutSeo?.ogImage || aboutPhoto || siteSettings.defaultOgImage}
  noindex={pageContent.aboutSeo?.noindex}
>
  <Breadcrumbs items={[{ label: 'Про мене' }]} />
  <section class="section">
    <div class="container grid gap-10 md:grid-cols-[0.9fr_1.1fr]">
      <div>
        <p class="eyebrow">{pageContent.aboutEyebrow}</p>
        <h1 class="mt-4 text-4xl font-semibold leading-tight md:text-5xl">
          {siteSettings.professionalName || siteSettings.siteName}
        </h1>
        {siteSettings.professionalRole && <p class="mt-4 text-lg text-[var(--color-muted)]">{siteSettings.professionalRole}</p>}
        {
          profilePhotoUrl && (
            <figure class="mt-8 overflow-hidden rounded-[var(--radius-large)] border border-[var(--color-border)] bg-[var(--color-surface)]">
              <img
                class="aspect-[4/5] h-full w-full object-cover"
                src={profilePhotoUrl}
                alt={siteSettings.professionalName || siteSettings.siteName}
                width="720"
                height="900"
              />
            </figure>
          )
        }
      </div>
      <div>
        <PortableText value={pageContent.aboutIntro} />
      </div>
    </div>
  </section>
  {
    pageContent.experienceSections.length > 0 && (
      <section class="section bg-[var(--color-surface)]">
        <div class="container">
          <h2 class="text-3xl font-semibold">{pageContent.experienceTitle}</h2>
          <div class="mt-8 grid gap-5">
            {pageContent.experienceSections.map((item) => {
              const imageUrl = item.image
                ? sanityImageUrl(item.image)?.width(1200).height(900).fit('max').auto('format').url()
                : null;

              return (
                <article class="experience-item">
                  <div>
                    {item.period && <p class="eyebrow">{item.period}</p>}
                    <h3 class="mt-2 text-2xl font-semibold">{item.title}</h3>
                    {item.text && <div class="mt-4"><PortableText value={item.text} /></div>}
                  </div>
                  {imageUrl && (
                    <figure class="overflow-hidden rounded-[var(--radius-large)] border border-[var(--color-border)] bg-white">
                      <img
                        class="aspect-[4/3] h-full w-full object-contain"
                        src={imageUrl}
                        alt={item.imageAlt || item.title}
                        width="1200"
                        height="900"
                        loading="lazy"
                      />
                    </figure>
                  )}
                </article>
              );
            })}
          </div>
        </div>
      </section>
    )
  }
  <GlobalCTA placement="about_final" pageType="about" contactSettings={contactSettings} cta={defaultCTA} />
</Layout>
