---
import Layout from '../../components/layout/Layout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import { getConcerns, getPageContentSettings } from '../../lib/data';
import { concernSignals, concernSignalsClosing } from '../../lib/content';

const [concerns, pageContent] = await Promise.all([getConcerns(), getPageContentSettings()]);
---

<Layout
  title={pageContent.concernsArchiveSeo?.title || 'З чим працюю'}
  description={pageContent.concernsArchiveSeo?.description || pageContent.concernsArchiveDescription}
  canonicalPath="/zapyt"
  image={pageContent.concernsArchiveSeo?.ogImage}
  noindex={pageContent.concernsArchiveSeo?.noindex}
>
  <Breadcrumbs items={[{ label: 'З чим працюю' }]} />
  <section class="section">
    <div class="container">
      <p class="eyebrow">{pageContent.concernsArchiveEyebrow}</p>
      <h1 class="mt-4 text-4xl font-semibold leading-tight md:text-5xl">{pageContent.concernsArchiveTitle}</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-[var(--color-muted)]">{pageContent.concernsArchiveDescription}</p>
      <div class="mt-10 rounded-[var(--radius-large)] border border-[var(--color-border)] bg-[var(--color-surface-muted)] p-6 md:p-8">
        <h2 class="text-2xl font-semibold">До мене звертаються, коли</h2>
        <ul class="mt-6 grid gap-x-8 gap-y-3 text-[var(--color-muted)] md:grid-cols-2">
          {concernSignals.map((signal) => (
            <li class="flex gap-3 before:mt-[0.65em] before:block before:h-1.5 before:w-1.5 before:shrink-0 before:rounded-full before:bg-[var(--color-warm)]">
              {signal}
            </li>
          ))}
        </ul>
        <p class="mt-6 leading-7 text-[var(--color-muted)]">{concernSignalsClosing}</p>
      </div>
      <div class="mt-10 grid gap-4 md:grid-cols-3">
        {concerns.map((concern) => (
          <a class="rounded-lg border border-[var(--color-line)] bg-[var(--color-surface)] p-5 hover:border-[var(--color-accent)]" href={`/zapyt/${concern.slug}`}>
            <h2 class="text-lg font-semibold">{concern.title}</h2>
            <p class="mt-3 text-sm leading-6 text-[var(--color-muted)]">{concern.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
