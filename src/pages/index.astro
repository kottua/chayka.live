---
import Layout from '../components/layout/Layout.astro';
import GlobalCTA from '../components/cta/GlobalCTA.astro';
import {
  getArticles,
  getConcerns,
  getContactSettings,
  getDefaultCTA,
  getPageContentSettings,
  getSiteSettings,
  getServices,
} from '../lib/data';
import { sanityImageUrl } from '../lib/sanity/image';

const [articles, concerns, contactSettings, defaultCTA, pageContent, services, siteSettings] = await Promise.all([
  getArticles(),
  getConcerns(),
  getContactSettings(),
  getDefaultCTA(),
  getPageContentSettings(),
  getServices(),
  getSiteSettings(),
]);
const heroPhoto = pageContent.homeHeroPhoto || siteSettings.profilePhoto;
const heroPhotoUrl = heroPhoto
  ? sanityImageUrl(heroPhoto)?.width(2400).height(1600).fit('crop').auto('format').url()
  : null;
---

<Layout
  title={pageContent.homeSeo?.title || pageContent.homeHeadline}
  description={pageContent.homeSeo?.description || pageContent.homeIntro}
  canonicalPath="/"
  image={pageContent.homeSeo?.ogImage || heroPhoto || siteSettings.defaultOgImage}
  noindex={pageContent.homeSeo?.noindex}
>
  <section class={`home-hero ${heroPhotoUrl ? 'home-hero-with-image' : ''}`}>
    {heroPhotoUrl && <img class="home-hero-image" src={heroPhotoUrl} alt="" width="2400" height="1600" />}
    <div class="container home-hero-content">
      <div class="max-w-3xl">
        <p class="eyebrow">{pageContent.homeEyebrow}</p>
        <h1 class="mt-4 text-4xl font-semibold leading-tight md:text-6xl">{pageContent.homeHeadline}</h1>
        {pageContent.homeIntro && <p class="mt-6 max-w-2xl text-lg leading-8 text-[var(--color-muted)]">{pageContent.homeIntro}</p>}
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="button-primary focus-ring inline-flex items-center px-5" href="/zapys-na-konsultatsiiu">
            {pageContent.homePrimaryButtonLabel}
          </a>
          <a class="focus-ring inline-flex min-h-[var(--size-touch-target)] items-center rounded-[var(--radius-base)] border border-[var(--color-border)] bg-[var(--color-surface)] px-5 font-semibold hover:border-[var(--color-brand-soft)] hover:bg-[var(--color-surface-muted)]" href="/poslugy">
            {pageContent.homeSecondaryButtonLabel}
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-[var(--color-surface)]">
    <div class="container">
      <p class="eyebrow">{pageContent.servicesSectionEyebrow}</p>
      <h2 class="mt-3 text-3xl font-semibold">{pageContent.servicesSectionTitle}</h2>
      <div class="mt-8 grid gap-4 md:grid-cols-3">
        {services.map((service) => (
          <a class="rounded-lg border border-[var(--color-line)] bg-white p-5 hover:border-[var(--color-accent)]" href={`/poslugy/${service.slug}`}>
            <h3 class="text-lg font-semibold">{service.title}</h3>
            <p class="mt-3 text-sm leading-6 text-[var(--color-muted)]">{service.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container grid gap-10 md:grid-cols-2">
      <div>
        <p class="eyebrow">{pageContent.concernsSectionEyebrow}</p>
        <h2 class="mt-3 text-3xl font-semibold">{pageContent.concernsSectionTitle}</h2>
        <div class="mt-8 grid gap-4">
          {concerns.map((concern) => (
            <a class="rounded-lg border border-[var(--color-line)] bg-[var(--color-surface)] p-5 hover:border-[var(--color-accent)]" href={`/zapyt/${concern.slug}`}>
              <h3 class="font-semibold">{concern.title}</h3>
              <p class="mt-2 text-sm leading-6 text-[var(--color-muted)]">{concern.description}</p>
            </a>
          ))}
        </div>
      </div>
      <div>
        <p class="eyebrow">{pageContent.articlesSectionEyebrow}</p>
        <h2 class="mt-3 text-3xl font-semibold">{pageContent.articlesSectionTitle}</h2>
        <div class="mt-8 grid gap-4">
          {articles.map((article) => (
            <a class="rounded-lg border border-[var(--color-line)] bg-[var(--color-surface)] p-5 hover:border-[var(--color-accent)]" href={`/statti/${article.slug}`}>
              <h3 class="font-semibold">{article.title}</h3>
              <p class="mt-2 text-sm leading-6 text-[var(--color-muted)]">{article.excerpt}</p>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <GlobalCTA placement="home_final" pageType="home" contactSettings={contactSettings} cta={defaultCTA} />
</Layout>
