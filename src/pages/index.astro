---
import Layout from '../components/layout/Layout.astro';
import GlobalCTA from '../components/cta/GlobalCTA.astro';
import {
  getArticles,
  getConcerns,
  getContactSettings,
  getDefaultCTA,
  getSiteSettings,
  getServices,
} from '../lib/data';
import { sanityImageUrl } from '../lib/sanity/image';

const [articles, concerns, contactSettings, defaultCTA, services, siteSettings] = await Promise.all([
  getArticles(),
  getConcerns(),
  getContactSettings(),
  getDefaultCTA(),
  getServices(),
  getSiteSettings(),
]);
const profilePhotoUrl = siteSettings.profilePhoto
  ? sanityImageUrl(siteSettings.profilePhoto)?.width(720).height(900).fit('crop').auto('format').url()
  : null;
---

<Layout
  title="Психотерапія онлайн"
  description="Психотерапевтична підтримка онлайн: робота з тривогою, стосунками, виснаженням і складними періодами у зручному форматі."
  canonicalPath="/"
  image={siteSettings.profilePhoto || siteSettings.defaultOgImage}
>
  <section class="section">
    <div class="container grid gap-10 md:grid-cols-[1.1fr_0.9fr] md:items-center">
      <div>
        <p class="eyebrow">Психотерапія онлайн</p>
        <h1 class="mt-4 max-w-3xl text-4xl font-semibold leading-tight md:text-6xl">
          Простір для розмови про те, що всередині вже давно потребує уваги
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-[var(--color-muted)]">
          Онлайн-консультації для моментів, коли важливо розібратися з тривогою, виснаженням, стосунками або внутрішньою напругою без поспіху й тиску.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="button-primary focus-ring inline-flex items-center px-5" href="/zapys-na-konsultatsiiu">
            Звернутися
          </a>
          <a class="focus-ring inline-flex min-h-[var(--size-touch-target)] items-center rounded-[var(--radius-base)] border border-[var(--color-border)] bg-[var(--color-surface)] px-5 font-semibold hover:border-[var(--color-brand-soft)] hover:bg-[var(--color-surface-muted)]" href="/poslugy">
            Подивитись послуги
          </a>
        </div>
      </div>
      {
        profilePhotoUrl ? (
          <figure class="overflow-hidden rounded-[var(--radius-large)] border border-[var(--color-border)] bg-[var(--color-surface)]">
            <img
              class="aspect-[4/5] h-full w-full object-cover"
              src={profilePhotoUrl}
              alt={siteSettings.professionalName || siteSettings.siteName}
              width="720"
              height="900"
            />
          </figure>
        ) : (
          <div class="rounded-[var(--radius-large)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6">
            <p class="text-sm font-semibold text-[var(--color-accent-strong)]">Перший контакт</p>
            <ul class="mt-4 grid gap-3 text-sm leading-6 text-[var(--color-muted)]">
              <li>Можна написати коротко, без готового формулювання запиту.</li>
              <li>Формат роботи й перший крок можна уточнити в зручному каналі.</li>
              <li>Конфіденційність і межі роботи проговорюються перед початком консультацій.</li>
            </ul>
          </div>
        )
      }
    </div>
  </section>

  <section class="section bg-[var(--color-surface)]">
    <div class="container">
      <p class="eyebrow">Напрямки</p>
      <h2 class="mt-3 text-3xl font-semibold">Послуги</h2>
      <div class="mt-8 grid gap-4 md:grid-cols-3">
        {services.map((service) => (
          <a class="rounded-lg border border-[var(--color-line)] bg-white p-5 hover:border-[var(--color-accent)]" href={`/poslugy/${service.slug}`}>
            <h3 class="text-lg font-semibold">{service.title}</h3>
            <p class="mt-3 text-sm leading-6 text-[var(--color-muted)]">{service.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container grid gap-10 md:grid-cols-2">
      <div>
        <p class="eyebrow">Запити</p>
        <h2 class="mt-3 text-3xl font-semibold">Сторінки під конкретний пошуковий намір</h2>
        <div class="mt-8 grid gap-4">
          {concerns.map((concern) => (
            <a class="rounded-lg border border-[var(--color-line)] bg-[var(--color-surface)] p-5 hover:border-[var(--color-accent)]" href={`/zapyt/${concern.slug}`}>
              <h3 class="font-semibold">{concern.title}</h3>
              <p class="mt-2 text-sm leading-6 text-[var(--color-muted)]">{concern.description}</p>
            </a>
          ))}
        </div>
      </div>
      <div>
        <p class="eyebrow">База знань</p>
        <h2 class="mt-3 text-3xl font-semibold">Перші статті</h2>
        <div class="mt-8 grid gap-4">
          {articles.map((article) => (
            <a class="rounded-lg border border-[var(--color-line)] bg-[var(--color-surface)] p-5 hover:border-[var(--color-accent)]" href={`/statti/${article.slug}`}>
              <h3 class="font-semibold">{article.title}</h3>
              <p class="mt-2 text-sm leading-6 text-[var(--color-muted)]">{article.excerpt}</p>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <GlobalCTA placement="home_final" pageType="home" contactSettings={contactSettings} cta={defaultCTA} />
</Layout>
