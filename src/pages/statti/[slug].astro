---
import PortableText from '../../components/content/PortableText.astro';
import GlobalCTA from '../../components/cta/GlobalCTA.astro';
import Layout from '../../components/layout/Layout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import {
  getArticles,
  getContactSettings,
  getDefaultCTA,
  getServices,
} from '../../lib/data';
import { buildArticleJsonLd, buildBreadcrumbJsonLd } from '../../lib/seo/jsonLd';
import { sanityImageUrl } from '../../lib/sanity/image';

export async function getStaticPaths() {
  const articles = await getArticles();

  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const [allArticles, contactSettings, defaultCTA, allServices] = await Promise.all([
  getArticles(),
  getContactSettings(),
  getDefaultCTA(),
  getServices(),
]);
const relatedServices = (article.relatedServices?.length ? article.relatedServices : allServices).slice(0, 3);
const relatedArticles = (
  article.relatedArticles?.length
    ? article.relatedArticles
    : allArticles.filter((candidate) => candidate.slug !== article.slug)
).filter((candidate) => candidate.slug !== article.slug).slice(0, 3);
const hasBody = Array.isArray(article.body) && article.body.length > 0;
const seoTitle = article.seo?.title || article.title;
const seoDescription = article.seo?.description || article.excerpt || article.description;
const articlePath = `/statti/${article.slug}`;
const canonicalPath = article.seo?.canonicalOverride || articlePath;
const clusterImage = (() => {
  const slug = article.slug;
  if (/stosunk|pari|simyi|zrad|spivzalezh/.test(slug)) return '/images/clusters/relationships.webp';
  if (/hovoryty-ni|chuzhoi-dumky|mezh/.test(slug)) return '/images/clusters/boundaries.webp';
  if (/vyhorann|dratuie|vysnazh/.test(slug)) return '/images/clusters/burnout.webp';
  if (/tryvo|pohane|panich/.test(slug)) return '/images/clusters/anxiety.webp';
  if (/samoot|krytyk|nevpev|pomyl|rishennia|khochu|poklyk/.test(slug)) return '/images/clusters/self-esteem.webp';
  return '/images/clusters/first-consultation.webp';
})();
const shareImage = article.seo?.ogImage || article.heroImage || article.heroImageUrl || clusterImage;
const heroImageUrl =
  article.heroImageUrl ||
  (article.heroImage
    ? sanityImageUrl(article.heroImage)?.width(1120).height(630).fit('crop').auto('format').url()
    : clusterImage);
---

<Layout
  title={seoTitle}
  description={seoDescription}
  canonicalPath={canonicalPath}
  noindex={article.seo?.noindex}
  image={shareImage}
>
  <JsonLd data={buildBreadcrumbJsonLd([{ label: 'Статті', path: '/statti' }, { label: article.title, path: articlePath }])} />
  <JsonLd
    data={buildArticleJsonLd({
      title: article.title,
      description: seoDescription,
      path: articlePath,
      publishedAt: article.publishedAt,
    })}
  />
  <Breadcrumbs items={[{ label: 'Статті', href: '/statti' }, { label: article.title }]} />
  <section class="section">
    <div class="container grid gap-10 md:grid-cols-[1fr_360px]">
      <article>
        <p class="eyebrow">Стаття</p>
        <h1 class="mt-4 text-4xl font-semibold leading-tight md:text-5xl">{article.title}</h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-[var(--color-muted)]">{article.excerpt}</p>
        {
          heroImageUrl && (
            <figure class="mt-8 overflow-hidden rounded-[var(--radius-large)] border border-[var(--color-border)] bg-[var(--color-surface)]">
              <img
                class="aspect-[16/9] h-full w-full object-cover"
                src={heroImageUrl}
                alt={article.title}
                width="1120"
                height="630"
              />
            </figure>
          )
        }

        <div class="mt-10">
          {hasBody ? (
            <PortableText value={article.body} />
          ) : (
            <div class="portable-text">
              <p>
                Повний текст статті буде доповнювати цю тему поступово: з поясненнями, прикладами і відповідями на практичні питання.
              </p>
            </div>
          )}
        </div>

        <aside class="mt-12 rounded-[var(--radius-large)] border border-[var(--color-border)] bg-[var(--color-surface-muted)] p-6">
          <p class="eyebrow">Авторка матеріалу</p>
          <h2 class="mt-3 text-xl font-semibold">{article.author?.name || 'Валентина Чайка'}</h2>
          <p class="mt-1 text-sm font-medium text-[var(--color-accent-strong)]">
            {article.author?.role || 'Психолог, психотерапевт'}
          </p>
          <p class="mt-3 text-sm leading-6 text-[var(--color-muted)]">
            {article.author?.shortBio || 'Практична психологиня, яка працює з тривогою, самооцінкою, межами, життєвими кризами та стосунками.'}
          </p>
          <a class="mt-4 inline-flex font-semibold text-[var(--color-accent-strong)] underline underline-offset-4" href="/pro-mene">
            Про освіту та підхід Валентини
          </a>
        </aside>
      </article>

      <aside class="grid content-start gap-6 self-start">
        <div class="rounded-lg border border-[var(--color-line)] bg-[var(--color-surface)] p-5">
          <h2 class="font-semibold">Пов'язані послуги</h2>
          <div class="mt-4 grid gap-3">
            {relatedServices.map((service) => (
              <a class="text-sm leading-6 text-[var(--color-muted)] hover:text-[var(--color-ink)]" href={`/poslugy/${service.slug}`}>{service.title}</a>
            ))}
          </div>
        </div>
        {relatedArticles.length > 0 && (
          <div class="rounded-lg border border-[var(--color-line)] bg-[var(--color-surface)] p-5">
            <h2 class="font-semibold">Пов'язані статті</h2>
            <div class="mt-4 grid gap-3">
              {relatedArticles.map((relatedArticle) => (
                <a class="text-sm leading-6 text-[var(--color-muted)] hover:text-[var(--color-ink)]" href={`/statti/${relatedArticle.slug}`}>{relatedArticle.title}</a>
              ))}
            </div>
          </div>
        )}
      </aside>
    </div>
  </section>
  <GlobalCTA
    placement="article_final"
    pageType="article"
    contentId={article.slug}
    contactSettings={contactSettings}
    cta={article.cta || defaultCTA}
  />
</Layout>
